BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Half Staff//Idaho + Federal//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Flag — Half Staff (Idaho)
X-WR-CALDESC:Federal half-staff days with reminders to lower and to raise back up.
X-WR-TIMEZONE:America/Denver
REFRESH-INTERVAL;VALUE=DURATION:PT12H
X-PUBLISHED-TTL:PT12H
BEGIN:VEVENT
UID:peace-2026@halfstaff
DTSTAMP:20260824T000000Z
DTSTART;VALUE=DATE:20260515
DTEND;VALUE=DATE:20260516
SUMMARY:Half-staff — Peace Officers Memorial Day
DESCRIPTION:Flags at half-staff all day for officers killed in the line o
 f duty. Federal flag law\, 4 U.S.C. 7(m).
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT6H
DESCRIPTION:Flag goes to half-staff tomorrow — Peace Officers Memorial Da
 y
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:PT7H
DESCRIPTION:Lower the flag to half-staff today. Raise it to the peak firs
 t\, then lower it.
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:peace-2026@halfstaff-raise
DTSTAMP:20260824T000000Z
DTSTART;VALUE=DATE:20260516
DTEND;VALUE=DATE:20260517
SUMMARY:Raise the flag back to full staff
DESCRIPTION:Yesterday's order has ended. Raise it to the peak.
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:PT7H30M
DESCRIPTION:Raise the flag back to full staff this morning.
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:memorial-2026@halfstaff
DTSTAMP:20260824T000000Z
DTSTART;VALUE=DATE:20260525
DTEND;VALUE=DATE:20260526
SUMMARY:Half-staff until NOON — Memorial Day
DESCRIPTION:Half-staff from sunrise until noon\, then raised briskly to f
 ull staff for the rest of the day.
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT6H
DESCRIPTION:Flag goes to half-staff tomorrow — Memorial Day
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:PT7H
DESCRIPTION:Lower the flag to half-staff today. Raise it to the peak firs
 t\, then lower it.
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:memorial-2026@halfstaff-noon
DTSTAMP:20260824T000000Z
DTSTART;TZID=America/Denver:20260525T120000
DTEND;TZID=America/Denver:20260525T121500
SUMMARY:Raise the flag to FULL staff — Memorial Day noon
DESCRIPTION:At noon the flag is raised briskly to the peak and stays ther
 e until sundown. The morning mourns the dead\; the afternoon belongs to 
 the living.
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT5M
DESCRIPTION:Raise the flag to full staff in 5 minutes.
END:VALARM
END:VEVENT
